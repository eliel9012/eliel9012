; pjsip.conf — Asterisk PJSIP — Mega Net Lab
; Copiar para /etc/asterisk/pjsip.conf e ajustar antes de usar.
; Nunca publicar o arquivo com senha real.

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0

; Endpoint principal — Grandstream HT812
[ht812]
type=endpoint
context=from-ht812
disallow=all
allow=ulaw,alaw
dtmf_mode=auto
direct_media=no
auth=ht812-auth
aors=ht812
rewrite_contact=yes
force_rport=yes
rtp_symmetric=yes
; Para fax: habilitar T.38 se o HT812 suportar
; fax_detect=yes
; t38_udptl=yes
; t38_udptl_ec=redundancy

[ht812-auth]
type=auth
auth_type=userpass
username=ht812
; IMPORTANTE: troque esta senha por uma senha forte antes de usar
password=troque-esta-senha

[ht812]
type=aor
max_contacts=1
