; extensions.conf — Dialplan Asterisk — Mega Net Lab
; Copiar para /etc/asterisk/extensions.conf e ajustar antes de usar.

[globals]
; Diretório base para sessões. Ajuste conforme seu ambiente.
MEGANET_BASE=/opt/meganet-lab/sessions

[from-ht812]
; Rota genérica: atende qualquer número, grava WAV, captura logs.
; O Asterisk atende, grava o áudio completo e aguarda o Mega Net enviar dados.
exten => _X!,1,Set(SESSION=${STRFTIME(${EPOCH},,%Y%m%d-%H%M%S)}-${EXTEN})
 same => n,Set(DIR=${MEGANET_BASE}/${SESSION})
 same => n,System(mkdir -p ${DIR})
 same => n,NoOp(MEGANET_SESSION_START session=${SESSION} numero=${EXTEN})
 same => n,Answer()
 same => n,MixMonitor(${DIR}/audio.wav,b)
 same => n,Wait(30)
 same => n,StopMixMonitor()
 same => n,Hangup()

; Rota de fax: ReceiveFAX() aguarda transmissão de fax do Mega Net.
; Para testar: configurar este ramal como destino da chamada do Mega Net,
; ou adicionar lógica de detecção de fax na rota genérica acima.
exten => fax,1,Set(SESSION=${STRFTIME(${EPOCH},,%Y%m%d-%H%M%S)}-fax)
 same => n,Set(DIR=${MEGANET_BASE}/${SESSION})
 same => n,System(mkdir -p ${DIR})
 same => n,NoOp(MEGANET_FAX_START session=${SESSION})
 same => n,Answer()
 same => n,MixMonitor(${DIR}/audio.wav,b)
 same => n,Wait(2)
 same => n,ReceiveFAX(${DIR}/fax-recebido.tif,d)
 same => n,NoOp(MEGANET_FAXSTATUS=${FAXSTATUS})
 same => n,NoOp(MEGANET_FAXERROR=${FAXERROR})
 same => n,NoOp(MEGANET_FAXPAGES=${FAXPAGES})
 same => n,NoOp(MEGANET_FAXBITRATE=${FAXBITRATE})
 same => n,NoOp(MEGANET_FAXMODE=${FAXMODE})
 same => n,StopMixMonitor()
 same => n,Hangup()

; Nota: durante testes de fax, o dialplan pode ser ajustado para enviar
; qualquer número discado pelo Mega Net diretamente para ReceiveFAX().
; Exemplo:
;
; exten => _X!,1,Goto(from-ht812,fax,1)
;
; Reative a rota genérica quando quiser gravar sem tentar receber fax.

; Contexto para envio de fax para o Mega Net (Camada 2, fase de recepção).
[meganet-send-fax]
; Iniciar manualmente via CLI do Asterisk:
;   channel originate PJSIP/ht812 extension sendfax@meganet-send-fax
exten => sendfax,1,Set(SESSION=${STRFTIME(${EPOCH},,%Y%m%d-%H%M%S)}-sendfax)
 same => n,Set(DIR=${MEGANET_BASE}/${SESSION})
 same => n,System(mkdir -p ${DIR})
 same => n,NoOp(MEGANET_SENDFAX_START session=${SESSION})
 same => n,Answer()
 same => n,MixMonitor(${DIR}/audio.wav,b)
 same => n,Wait(2)
 ; Substituir /opt/meganet-lab/teste.tif pelo arquivo TIF de teste desejado
 same => n,SendFAX(/opt/meganet-lab/teste.tif,d)
 same => n,NoOp(MEGANET_FAXSTATUS=${FAXSTATUS})
 same => n,NoOp(MEGANET_FAXERROR=${FAXERROR})
 same => n,StopMixMonitor()
 same => n,Hangup()
